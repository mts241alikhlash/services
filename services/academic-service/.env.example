# Copy to .env and fill in.
#
# NOTE: the same database as identity-service. That is not a mistake — see CLAUDE.md.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"
NODE_ENV=development
PORT=3200
# 0 for local development, where nothing sits in front of this process.
# Set to 1 whenever it runs behind the nginx gateway (docker-compose.prod.yml
# already does this): express then reads the real client IP from
# X-Forwarded-For. Left at 0 behind a proxy, req.ip resolves to the gateway's
# own container address for every caller, so the throttle buckets below become
# one shared bucket — the whole school gets locked out after AUTH_THROTTLE_LIMIT
# sign-in attempts between them.
TRUST_PROXY=0
# Must be byte-identical to identity-service's. This service verifies the tokens
# that one signs; a different secret rejects every request with a 401 that
# looks like an expiry.
JWT_SECRET=change-me-in-production
FRONTEND_URL=http://localhost:5173
# identity-service, called for session introspection (POST /auth/introspect,
# coupling 1) and the batch profile lookup (POST /profiles/batch, coupling 3)
# — see CLAUDE.md/ARCHITECTURE.md. Coupling 2 (account provisioning) does not
# call from here: hr-service and student-service own that caller now.
IDENTITY_SERVICE_URL=https://identity.example.com
# hr-service owns `teachers`; student-service owns `students` and
# `parents`. Asked over HTTP for the `/me` routes and the referential checks
# that used to be Prisma queries across the shared database.
HR_SERVICE_URL=https://hr.example.com
STUDENT_SERVICE_URL=https://student.example.com
# How long a resolved identity is trusted before asking again. This is the price
# of separating the databases: revocation is no longer instant, it is eventually
# consistent within this window. 0 disables the cache, making every
# authenticated request an HTTP round trip.
IDENTITY_CACHE_TTL_MS=5000
# Node's fetch has NO default timeout. Without this, an identity-service that
# accepts the connection but never answers hangs every authenticated request
# instead of failing fast with a 503.
IDENTITY_TIMEOUT_MS=3000
# Entries are keyed per token. The map is bounded by expiry and by this ceiling.
IDENTITY_CACHE_MAX_ENTRIES=1000
# In-flight introspections. Beyond this the service sheds load with a 503 rather
# than queueing behind a struggling identity-service.
IDENTITY_MAX_CONCURRENT_REQUESTS=100
# Same shared secret ProvisioningTokenGuard checks on identity-service's side
# — the caller here is this backend, not a signed-in person.
PROVISIONING_SERVICE_TOKEN=change-me-in-production
# How long a resolved profile is trusted before asking identity-service again.
# A profile edited on the role screen takes up to this long to show on a
# roster here. 60s by default; 0 disables the cache.
PROFILE_LOOKUP_CACHE_TTL_MS=60000

# --- Tuning. Every one has a working default; set them only to change it. ---
# Throttling is per IP; AUTH_* covers the sign-in routes specifically.
# THROTTLE_TTL=60000
# THROTTLE_LIMIT=100
# AUTH_THROTTLE_TTL=60000
# AUTH_THROTTLE_LIMIT=10
# JWT_ACCESS_EXPIRATION=15m
# JWT_REFRESH_EXPIRATION=7d
