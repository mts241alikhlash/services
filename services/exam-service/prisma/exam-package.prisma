enum ExamPackageStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
  LOCKED
}

enum PackageReviewAction {
  SUBMIT
  APPROVE
  RETURN
}

enum ExamType {
  UH
  QUIZ
  TUGAS
  UTS
  UAS
}

enum ExamScheduleStatus {
  SCHEDULED
  CANCELLED
}

/// A fixed set of approved questions for one subject and grade. Each item pins
/// the approved version number it had when it was added, so editing a question
/// afterwards never changes a package. A package is LOCKED the moment it is
/// scheduled and can then only be copied.
model ExamPackage {
  id          String            @id @default(uuid()) @db.Uuid
  title       String            @db.VarChar(200)
  subjectId   String            @map("subject_id") @db.Uuid
  gradeId     String            @map("grade_id") @db.Uuid
  status      ExamPackageStatus @default(DRAFT)
  lockedAt    DateTime?         @map("locked_at")
  createdById String            @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")

  items     ExamPackageItem[]
  schedules ExamSchedule[]
  questions Question[]
  reviews   ExamPackageReview[]

  @@index([subjectId, gradeId, status])
  @@index([status])
  @@map("exam_packages")
}

/// One step of a package's review: who submitted, approved or returned it,
/// the general note and the notes on single questions.
model ExamPackageReview {
  id            String              @id @default(uuid()) @db.Uuid
  packageId     String              @map("package_id") @db.Uuid
  action        PackageReviewAction
  byUserId      String              @map("by_user_id") @db.Uuid
  note          String?
  questionNotes Json                @default("[]") @map("question_notes")
  createdAt     DateTime            @default(now()) @map("created_at")

  package ExamPackage @relation(fields: [packageId], references: [id])

  @@index([packageId, createdAt])
  @@map("exam_package_reviews")
}

model ExamPackageItem {
  id              String @id @default(uuid()) @db.Uuid
  packageId       String @map("package_id") @db.Uuid
  questionId      String @map("question_id") @db.Uuid
  questionVersion Int    @map("question_version")
  position        Int

  package  ExamPackage @relation(fields: [packageId], references: [id])
  question Question    @relation(fields: [questionId], references: [id])

  @@unique([packageId, questionId])
  @@unique([packageId, position])
  @@index([questionId])
  @@map("exam_package_items")
}

enum ExamScheduleKind {
  REGULAR
  MAKEUP
}

enum MakeupReason {
  SICK
  PERMITTED
  ABSENT
  OTHER
}

/// One package scheduled for one classroom inside a time window. The access
/// code is never stored: it is derived from the schedule id and
/// `tokenRotation`, which only ever grows.
model ExamSchedule {
  id              String             @id @default(uuid()) @db.Uuid
  packageId       String             @map("package_id") @db.Uuid
  classroomId     String             @map("classroom_id") @db.Uuid
  semesterId      String             @map("semester_id") @db.Uuid
  startsAt        DateTime           @map("starts_at")
  endsAt          DateTime           @map("ends_at")
  durationMinutes Int                @map("duration_minutes")
  type            ExamType           @default(UH)
  kind            ExamScheduleKind   @default(REGULAR)
  makeupOfId      String?            @map("makeup_of_id") @db.Uuid
  tokenRotation   Int                @default(0) @map("token_rotation")
  status          ExamScheduleStatus @default(SCHEDULED)
  createdById     String             @map("created_by_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  package      ExamPackage               @relation(fields: [packageId], references: [id])
  makeupOf     ExamSchedule?             @relation("Makeups", fields: [makeupOfId], references: [id])
  makeups      ExamSchedule[]            @relation("Makeups")
  sessions     ExamSession[]
  participants ExamScheduleParticipant[]

  @@index([classroomId, startsAt])
  @@index([packageId])
  @@index([makeupOfId])
  @@map("exam_schedules")
}

/// A student allowed to sit a makeup schedule, with why they missed the
/// regular one.
model ExamScheduleParticipant {
  id         String       @id @default(uuid()) @db.Uuid
  scheduleId String       @map("schedule_id") @db.Uuid
  studentId  String       @map("student_id") @db.Uuid
  reason     MakeupReason
  note       String?      @db.VarChar(200)
  addedById  String       @map("added_by_id") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at")

  schedule ExamSchedule @relation(fields: [scheduleId], references: [id])

  @@unique([scheduleId, studentId])
  @@index([studentId])
  @@map("exam_schedule_participants")
}
