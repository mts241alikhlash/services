model User {
  id           String    @id @default(uuid()) @db.Uuid
  identifier   String    @unique @db.VarChar(100)
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  profile             Profile?
  sessions            AuthSession[]
  userRoles           UserRole[]
  auditLogs           AuditLog[]
  uploadedFiles       File[]
  passwordResetTokens PasswordResetToken[]
  oauthAccounts       OAuthAccount[]

  @@map("users")
}

model AuthSession {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @map("token_hash") @db.VarChar(255)
  previousTokenHash String?   @map("previous_token_hash") @db.VarChar(255)
  previousRotatedAt DateTime? @map("previous_rotated_at")
  userAgent         String?   @map("user_agent") @db.VarChar(512)
  ipAddress         String?   @map("ip_address") @db.VarChar(64)
  expiresAt         DateTime  @map("expires_at")
  lastUsedAt        DateTime  @default(now()) @map("last_used_at")
  revokedAt         DateTime? @map("revoked_at")
  parentSessionId   String?   @map("parent_session_id") @db.Uuid
  appKey            String?   @map("app_key") @db.VarChar(30)
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   AuthSession?           @relation("SessionFamily", fields: [parentSessionId], references: [id], onDelete: Cascade)
  children AuthSession[]          @relation("SessionFamily")
  codes    SsoAuthorizationCode[]

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenHash])
  @@index([parentSessionId])
  @@map("auth_sessions")
}

model OAuthAccount {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String   @db.VarChar(20)
  providerUserId String   @map("provider_user_id") @db.VarChar(255)
  email          String   @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model SsoAuthorizationCode {
  id              String    @id @default(uuid()) @db.Uuid
  codeHash        String    @unique @map("code_hash") @db.VarChar(64)
  parentSessionId String    @map("parent_session_id") @db.Uuid
  appKey          String    @map("app_key") @db.VarChar(30)
  redirectUri     String    @map("redirect_uri") @db.VarChar(512)
  codeChallenge   String    @map("code_challenge") @db.VarChar(128)
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  childSessionId  String?   @map("child_session_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")

  parentSession AuthSession @relation(fields: [parentSessionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sso_authorization_codes")
}
