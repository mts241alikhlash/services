# Shared with every other service: JWT_SECRET and PROVISIONING_SERVICE_TOKEN
#
# This service owns ten tables — users, profiles, roles, permissions,
# user_roles, role_permissions, auth_sessions, password_reset_tokens, files,
# file_categories — but does not own the database: academic-service's
# authorization reads four of them on every request, so both point here.
#
# Never run `prisma migrate` against it. The schema in `prisma/` describes ten
# of the 119 models present, and Prisma would drop the rest. See CLAUDE.md.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

NODE_ENV=development
PORT=3000
# 0 for local development, where nothing sits in front of this process.
# Set to 1 whenever it runs behind the nginx gateway (docker-compose.prod.yml
# already does this): express then reads the real client IP from
# X-Forwarded-For. Left at 0 behind a proxy, req.ip resolves to the gateway's
# own container address for every caller, so the throttle buckets below become
# one shared bucket — the whole school gets locked out after AUTH_THROTTLE_LIMIT
# sign-in attempts between them.
TRUST_PROXY=0

THROTTLE_TTL=60000
THROTTLE_LIMIT=500
# Sign-in, refresh, password reset. Deliberately far tighter.
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=20

JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
BCRYPT_SALT_ROUNDS=10

# Google sign-in (GET /auth/google, /auth/google/callback). Callback URL must
# be registered exactly in the Google Cloud Console OAuth client.
GOOGLE_CLIENT_ID=change-me-in-production
GOOGLE_CLIENT_SECRET=change-me-in-production
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# Frontend page the browser lands on after a successful Google sign-in. The
# refresh cookie is already set by then, so this page just calls POST
# /auth/refresh to get its first access token. ?profileIncomplete=true|false
# is appended so it knows whether to route to the biodata form first.
GOOGLE_OAUTH_SUCCESS_REDIRECT_URL=http://localhost:5175/oauth/callback
# Origins a caller may pass as ?redirect= on GET /auth/google. The origin is
# carried through Google as OAuth state and re-validated on callback, so an
# unlisted origin silently falls back to GOOGLE_OAUTH_SUCCESS_REDIRECT_URL.
# Each entry must be a bare origin, without path or trailing slash.
GOOGLE_OAUTH_REDIRECT_ALLOWLIST=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178,http://localhost:5179
# Opt-in. When false, a Google sign-up with an unknown email creates no account
# and is told the account is not registered. Sign-in with Google is unaffected.
GOOGLE_SIGNUP_ENABLED=false

# Shared with academic-service, hr-service, student-service — each sends
# this as the x-provisioning-token header on POST/DELETE /accounts, since
# those callers are backends without a user JWT to authenticate with.
PROVISIONING_SERVICE_TOKEN=change-me-in-production

# Every frontend that signs in through this service, comma-separated.
#
# The refresh cookie is sameSite: 'strict' (ADR-0010), so a frontend on a
# foreign registrable domain gets no cookie and therefore no login at all — and
# that cannot reproduce locally, where everything is localhost.
FRONTEND_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177

# --- Tuning. Every one has a working default; set them only to change it. ---
# Throttling is per IP; AUTH_* covers the sign-in routes specifically.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# --- Object storage, for the profile photo only. ---
# Optional: without it the service boots normally and POST/DELETE
# /profiles/me/photo answer 503. Signing in must never depend on MinIO.
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=241-apps
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SIGNED_URL_EXPIRY_SECONDS=3600
