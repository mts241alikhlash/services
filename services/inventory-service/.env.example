DATABASE_URL="postgresql://user:password@host/inventory?sslmode=require"
DIRECT_URL="postgresql://user:password@host/inventory?sslmode=require"
NODE_ENV=development
PORT=3300
# Express must trust one proxy hop behind the nginx gateway so throttling uses
# the client IP; leave 0 when running without a proxy.
TRUST_PROXY=0
JWT_SECRET=local-development-secret-not-for-production
FRONTEND_URL=http://localhost:5174

IDENTITY_SERVICE_URL=https://identity.example.com
# Cache TTL is the revocation window; 0 disables caching.
IDENTITY_CACHE_TTL_MS=5000
# Timeout prevents a stalled identity request from hanging; failure returns 503.
IDENTITY_TIMEOUT_MS=3000
IDENTITY_CACHE_MAX_ENTRIES=1000
# Shed load with 503 when distinct introspections exceed this limit.
IDENTITY_MAX_CONCURRENT_REQUESTS=100
