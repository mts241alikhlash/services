enum StudentStatus {
  ACTIVE
  TRANSFERRED
  DROPPED
  GRADUATED
}

model Student {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @unique @map("user_id") @db.Uuid
  nis       String        @db.VarChar(20)
  nisn      String        @db.VarChar(20)
  status    StudentStatus @default(ACTIVE)
  gradeId   String?       @map("grade_id") @db.Uuid
  deletedAt DateTime?     @map("deleted_at")
  parents         StudentParent[]
  enrollments     StudentEnrollment[]
  graduations     StudentGraduation[]
  graduationHolds StudentGraduationHold[]

  @@unique([nis], where: { deletedAt: null })
  @@unique([nisn], where: { deletedAt: null })
  @@index([status])
  @@index([gradeId])
  @@map("students")
}
