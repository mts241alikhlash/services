enum UserGender {
  MALE
  FEMALE
}

enum AdmissionStatus {
  DRAFT
  SUBMITTED
  REVISION_NEEDED
  VERIFIED
  ACCEPTED
  ENROLLING
  REJECTED
  ENROLLED
}

enum AdmissionDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdmissionPaymentStatus {
  UNPAID
  PENDING
  VERIFIED
  REJECTED
}

enum AdmissionNotificationType {
  STATUS_CHANGE
  DOCUMENT
  PAYMENT
  ANNOUNCEMENT
  GENERAL
}

enum ParentRelation {
  FATHER
  MOTHER
  GUARDIAN
}

model AdmissionWave {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String    @db.VarChar(100)
  code                String    @unique @db.VarChar(30)
  academicYearId      String    @map("academic_year_id") @db.Uuid
  startDate           DateTime  @map("start_date") @db.Date
  endDate             DateTime  @map("end_date") @db.Date
  quota               Int
  registrationFee     Decimal   @map("registration_fee") @db.Decimal(12, 2)
  description         String?   @db.Text
  isActive            Boolean   @default(true) @map("is_active")
  lastRegistrationSeq Int       @default(0) @map("last_registration_seq")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  applications  AdmissionApplication[]
  announcements AdmissionAnnouncement[]

  @@index([academicYearId])
  @@index([isActive])
  @@map("admission_waves")
}

model AdmissionApplication {
  id                 String          @id @default(uuid()) @db.Uuid
  userId             String          @unique @map("user_id") @db.Uuid
  waveId             String          @map("wave_id") @db.Uuid
  registrationNumber String          @unique @map("registration_number") @db.VarChar(30)
  status             AdmissionStatus @default(DRAFT)

  fullName     String      @map("full_name") @db.VarChar(100)
  nickname     String?     @db.VarChar(50)
  gender       UserGender?
  birthPlace   String?     @map("birth_place") @db.VarChar(100)
  birthDate    DateTime?   @map("birth_date") @db.Date
  nik          String?     @db.VarChar(16)
  nisn         String?     @db.VarChar(20)
  religionId   String?     @map("religion_id") @db.Uuid
  phone        String?     @db.VarChar(15)
  email        String?     @db.VarChar(255)
  childOrder   Int?        @map("child_order")
  siblingCount Int?        @map("sibling_count")

  street     String? @db.VarChar(255)
  rt         String? @db.VarChar(5)
  rw         String? @db.VarChar(5)
  village    String? @db.VarChar(100)
  district   String? @db.VarChar(100)
  city       String? @db.VarChar(100)
  province   String? @db.VarChar(100)
  postalCode String? @map("postal_code") @db.VarChar(10)

  provinceCode String? @map("province_code") @db.VarChar(13)
  regencyCode  String? @map("regency_code") @db.VarChar(13)
  districtCode String? @map("district_code") @db.VarChar(13)
  villageCode  String? @map("village_code") @db.VarChar(13)

  hobby              String? @db.VarChar(100)
  aspiration         String? @db.VarChar(100)
  financingSourceId  String? @map("financing_source_id") @db.Uuid
  disabilityTypeId   String? @map("disability_type_id") @db.Uuid
  specialNeedId      String? @map("special_need_id") @db.Uuid
  studentResidenceId String? @map("student_residence_id") @db.Uuid
  travelDistanceId   String? @map("travel_distance_id") @db.Uuid
  travelTimeId       String? @map("travel_time_id") @db.Uuid
  transportationId   String? @map("transportation_id") @db.Uuid

  previousSchoolName    String? @map("previous_school_name") @db.VarChar(200)
  previousSchoolNpsn    String? @map("previous_school_npsn") @db.VarChar(20)
  previousSchoolAddress String? @map("previous_school_address") @db.VarChar(255)
  graduationYear        Int?    @map("graduation_year")

  submittedAt       DateTime? @map("submitted_at")
  revisionNote      String?   @map("revision_note") @db.Text
  verifiedById      String?   @map("verified_by_id") @db.Uuid
  verifiedAt        DateTime? @map("verified_at")
  decidedById       String?   @map("decided_by_id") @db.Uuid
  decidedAt         DateTime? @map("decided_at")
  decisionNote      String?   @map("decision_note") @db.Text
  enrolledStudentId String?   @unique @map("enrolled_student_id") @db.Uuid
  enrolledAt        DateTime? @map("enrolled_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  parents       AdmissionApplicationParent[]
  documents     AdmissionDocument[]
  payment       AdmissionPayment?
  notifications AdmissionNotification[]
  achievements  AdmissionAchievement[]
  scholarships  AdmissionScholarship[]

  wave AdmissionWave @relation(fields: [waveId], references: [id])

  @@index([status])
  @@index([waveId])
  @@map("admission_applications")
}

model AdmissionApplicationParent {
  id            String         @id @default(uuid()) @db.Uuid
  applicationId String         @map("application_id") @db.Uuid
  relation      ParentRelation
  name          String         @db.VarChar(100)
  nik           String?        @db.VarChar(16)
  birthPlace    String?        @map("birth_place") @db.VarChar(100)
  birthDate     DateTime?      @map("birth_date") @db.Date
  phone         String?        @db.VarChar(15)
  occupationId  String?        @map("occupation_id") @db.Uuid
  educationId   String?        @map("education_id") @db.Uuid
  incomeRangeId String?        @map("income_range_id") @db.Uuid
  lifeStatusId  String?        @map("life_status_id") @db.Uuid
  domicileId    String?        @map("domicile_id") @db.Uuid
  residenceId   String?        @map("residence_id") @db.Uuid

  sameAddressAsStudent Boolean @default(true) @map("same_address_as_student")
  street               String? @db.VarChar(255)
  rt                   String? @db.VarChar(5)
  rw                   String? @db.VarChar(5)
  village              String? @db.VarChar(100)
  district             String? @db.VarChar(100)
  city                 String? @db.VarChar(100)
  province             String? @db.VarChar(100)
  postalCode           String? @map("postal_code") @db.VarChar(10)
  provinceCode         String? @map("province_code") @db.VarChar(13)
  regencyCode          String? @map("regency_code") @db.VarChar(13)
  districtCode         String? @map("district_code") @db.VarChar(13)
  villageCode          String? @map("village_code") @db.VarChar(13)

  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, relation])
  @@map("admission_application_parents")
}

model AdmissionAchievement {
  id                 String   @id @default(uuid()) @db.Uuid
  applicationId      String   @map("application_id") @db.Uuid
  sortOrder          Int      @default(0) @map("sort_order")
  year               Int
  competitionName    String   @map("competition_name") @db.VarChar(150)
  competitionFieldId String?  @map("competition_field_id") @db.Uuid
  organizer          String?  @db.VarChar(150)
  competitionLevelId String?  @map("competition_level_id") @db.Uuid
  rank               String?  @db.VarChar(50)
  fileId             String?  @map("file_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  file        File?                @relation(fields: [fileId], references: [id])

  @@index([applicationId])
  @@map("admission_achievements")
}

model AdmissionScholarship {
  id              String   @id @default(uuid()) @db.Uuid
  applicationId   String   @map("application_id") @db.Uuid
  sortOrder       Int      @default(0) @map("sort_order")
  year            Int
  categoryId      String?  @map("category_id") @db.Uuid
  scholarshipName String   @map("scholarship_name") @db.VarChar(150)
  providerName    String?  @map("provider_name") @db.VarChar(150)
  providerTypeId  String?  @map("provider_type_id") @db.Uuid
  duration        String?  @db.VarChar(50)
  kipNumber       String?  @map("kip_number") @db.VarChar(30)
  amount          Decimal? @db.Decimal(14, 2)
  fileId          String?  @map("file_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  file        File?                @relation(fields: [fileId], references: [id])

  @@index([applicationId])
  @@map("admission_scholarships")
}

model AdmissionDocumentType {
  id         String  @id @default(uuid()) @db.Uuid
  code       String  @unique @db.VarChar(30)
  name       String  @db.VarChar(100)
  isRequired Boolean @default(true) @map("is_required")
  sortOrder  Int     @default(0) @map("sort_order")
  isActive   Boolean @default(true) @map("is_active")

  documents AdmissionDocument[]

  @@map("admission_document_types")
}

model AdmissionDocument {
  id             String                  @id @default(uuid()) @db.Uuid
  applicationId  String                  @map("application_id") @db.Uuid
  documentTypeId String                  @map("document_type_id") @db.Uuid
  fileId         String                  @map("file_id") @db.Uuid
  status         AdmissionDocumentStatus @default(PENDING)
  note           String?                 @db.Text
  verifiedById   String?                 @map("verified_by_id") @db.Uuid
  verifiedAt     DateTime?               @map("verified_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  application  AdmissionApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentType AdmissionDocumentType @relation(fields: [documentTypeId], references: [id])
  file         File                  @relation(fields: [fileId], references: [id])

  @@unique([applicationId, documentTypeId])
  @@map("admission_documents")
}

model AdmissionPayment {
  id                String                 @id @default(uuid()) @db.Uuid
  applicationId     String                 @unique @map("application_id") @db.Uuid
  amount            Decimal                @db.Decimal(12, 2)
  bankName          String?                @map("bank_name") @db.VarChar(100)
  senderAccountName String?                @map("sender_account_name") @db.VarChar(100)
  transferDate      DateTime?              @map("transfer_date") @db.Date
  proofFileId       String?                @map("proof_file_id") @db.Uuid
  bankAccountId     String?                @map("bank_account_id") @db.Uuid
  status            AdmissionPaymentStatus @default(UNPAID)
  note              String?                @db.Text
  verifiedById      String?                @map("verified_by_id") @db.Uuid
  verifiedAt        DateTime?              @map("verified_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  application AdmissionApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  proofFile   File?                 @relation(fields: [proofFileId], references: [id])
  bankAccount AdmissionBankAccount? @relation(fields: [bankAccountId], references: [id])

  @@map("admission_payments")
}

model AdmissionAnnouncement {
  id          String    @id @default(uuid()) @db.Uuid
  waveId      String?   @map("wave_id") @db.Uuid
  title       String    @db.VarChar(200)
  content     String    @db.Text
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  wave AdmissionWave? @relation(fields: [waveId], references: [id])

  @@index([isPublished])
  @@map("admission_announcements")
}

model AdmissionNotification {
  id            String                    @id @default(uuid()) @db.Uuid
  applicationId String                    @map("application_id") @db.Uuid
  type          AdmissionNotificationType
  title         String                    @db.VarChar(200)
  message       String                    @db.Text
  readAt        DateTime?                 @map("read_at")
  createdAt     DateTime                  @default(now()) @map("created_at")

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, readAt])
  @@map("admission_notifications")
}

model AdmissionBankAccount {
  id            String    @id @default(uuid()) @db.Uuid
  bankName      String    @map("bank_name") @db.VarChar(100)
  accountNumber String    @map("account_number") @db.VarChar(30)
  accountHolder String    @map("account_holder") @db.VarChar(100)
  sortOrder     Int       @default(0) @map("sort_order")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  payments AdmissionPayment[]

  @@map("admission_bank_accounts")
}
