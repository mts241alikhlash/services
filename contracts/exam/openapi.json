    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Liveness and readiness check passed\n\nThe Health Check is successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Success"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "degraded"
                          ],
                          "example": "ok"
                        },
                        "info": {
                          "type": "object",
                          "example": {
                            "database": {
                              "status": "up",
                              "responseTime": 12
                            }
                          },
                          "additionalProperties": {
                            "type": "object",
                            "required": [
                              "status"
                            ],
                            "properties": {
                              "status": {
                                "type": "string",
                                "enum": [
                                  "up",
                                  "degraded",
                                  "down"
                                ]
                              },
                              "responseTime": {
                                "type": "number",
                                "description": "Time the health indicator took to respond, in ms"
                              }
                            },
                            "additionalProperties": true
                          },
                          "nullable": true
                        },
                        "error": {
                          "type": "object",
                          "example": {},
                          "additionalProperties": {
                            "type": "object",
                            "required": [
                              "status"
                            ],
                            "properties": {
                              "status": {
                                "type": "string",
                                "enum": [
                                  "up",
                                  "degraded",
                                  "down"
                                ]
                              },
                              "responseTime": {
                                "type": "number",
                                "description": "Time the health indicator took to respond, in ms"
                              }
                            },
                            "additionalProperties": true
                          },
                          "nullable": true
                        },
                        "details": {
                          "type": "object",
                          "example": {
                            "database": {
                              "status": "up",
                              "responseTime": 12
                            }
                          },
                          "additionalProperties": {
                            "type": "object",
                            "required": [
                              "status"
                            ],
                            "properties": {
                              "status": {
                                "type": "string",
                                "enum": [
                                  "up",
                                  "degraded",
                                  "down"
                                ]
                              },
                              "responseTime": {
                                "type": "number",
                                "description": "Time the health indicator took to respond, in ms"
                              }
                            },
                            "additionalProperties": true
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Health check failed\n\nThe Health Check is not successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "error",
                        "shutting_down"
                      ],
                      "example": "error"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        },
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Liveness + readiness probe (DB, memory)",
        "tags": [
          "Health"
        ]
      }
    }
